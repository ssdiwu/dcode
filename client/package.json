{
  "name": "@dcode/client",
  "version": "0.0.37",
  "private": true,
  "type": "module",
  "description": "D Code Web 客户端：Electron 平台壳 + React 呈现层，经 Protocol v1 消费既有 host/。",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "npm run verify:version && npm run verify:threeui && npm run verify:036-boundary && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "node_modules/.bin/vite build",
    "test": "npm run typecheck && npm run build:main && node --test dist/test/*.test.js && node --experimental-strip-types --test test/*.test.mjs",
    "smoke:host": "npm run build:main && node scripts/smoke-host.mjs",
    "seed:visual": "npm run build:main && node scripts/seed-store.mjs",
    "dev": "npm run build:main && node scripts/dev.mjs",
    "start": "npm run build && node scripts/dev.mjs --no-vite",
    "capture": "npm run build && node scripts/dev.mjs --capture",
    "dist": "node scripts/verify-version.mjs --require-target && npm run build && node scripts/package.mjs",
    "test:layout": "npm run build && node test/layout/geometry.mjs",
    "test:inputs": "npm run build && node test/layout/input-focus.mjs",
    "test:canvas": "npm run build && node test/layout/inspiration.mjs",
    "test:preview": "npm run build:main && node node_modules/electron/cli.js test/main/html-preview.mjs",
    "test:window-policy": "npm run build && node test/main/window-policy.mjs",
    "verify:threeui": "node scripts/verify-threeui.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:036-boundary": "node scripts/verify-036-boundary.mjs",
    "test:new-task": "npm run build && node test/main/new-task-ui.mjs",
    "test:source-detail": "npm run build && node test/main/source-detail.mjs",
    "test:task-continuation": "npm run build && node test/main/task-continuation.mjs",
    "test:review-diff": "npm run build && node test/main/review-diff.mjs",
    "test:command-menu": "node test/main/command-menu.mjs",
    "test:file-mention": "node test/main/file-mention.mjs",
    "test:task-workflow": "node test/main/task-workflow.mjs",
    "test:task-workflow-recovery": "node test/main/task-workflow-recovery.mjs",
    "test:child-session-header": "node test/main/child-session-header.mjs",
    "test:context-usage": "node test/main/context-usage.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.149.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@designcodeio/threeui": "1.2.0",
    "@floating-ui/react-dom": "2.1.9",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@shikijs/rehype": "^4.4.3",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "swr": "^2.5.1",
    "three": "0.149.0",
    "three128": "npm:three@0.128.0",
    "zustand": "^5.0.15"
  }
}
