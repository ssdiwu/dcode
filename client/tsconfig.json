{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "typeRoots": ["../host/node_modules/@types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/host/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "test/**/*.ts"
  ]
}
