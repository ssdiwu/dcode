{
  "name": "dcode-redesign",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "architecture:check": "node tools/architecture/check.mjs",
    "architecture:test": "node --test tools/architecture/check.test.mjs",
    "verify:architecture": "npm run architecture:test && npm run architecture:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:runtime": "node --import tsx --test test/runtime/*.test.ts test/runtime/*.test.mjs",
    "verify:runtime": "npm run verify:architecture && npm run typecheck && npm run lint && npm run test:runtime",
    "demo:pi": "node --import tsx tools/pi-runtime-demo.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:streaming-sim": "npm run build && node --test test/e2e/streaming-sim.test.mjs",
    "test:streaming-sim:baseline": "npm run build && DCODE_SIM_VARIANT=baseline node --test test/e2e/streaming-sim.test.mjs",
    "test:contracts": "node --test test/contracts-validation.test.mjs",
    "verify": "npm run verify:runtime && npm run test:contracts && npm run test:e2e",
    "desktop": "python3 tools/launch-desktop.py"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "41.0.3",
    "electron-vite": "4.0.1",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.1.9"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-tooltip": "1.3.0",
    "lucide-react": "0.545.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "@earendil-works/pi-telemetry": "1.0.0"
  },
  "main": "out/main/index.js",
  "version": "0.1.0-dev"
}
