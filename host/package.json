{
  "name": "@pi-dcode/host",
  "version": "0.0.37",
  "private": true,
  "type": "module",
  "bin": {
    "pi-dcode-host": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-native.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "grok-mermaid": "0.2.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typebox": "1.3.7",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
